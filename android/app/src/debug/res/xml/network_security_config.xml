<?xml version="1.0" encoding="utf-8"?>
<!--
  Izinkan cleartext HTTP ke Firebase emulator host (10.0.2.2) untuk debug build.
  Android emulator memetakan 10.0.2.2 ke host machine localhost.
  Ini HANYA berlaku untuk debug build — tidak mempengaruhi release/production.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
