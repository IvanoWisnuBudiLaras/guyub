<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Android 9+ blocks cleartext HTTP by default, but the
  Firebase emulator is served over plain HTTP on the host, so without this the
  app cannot reach Auth, Firestore, or Functions at 10.0.2.2 and every callable
  fails with `unavailable`.

  Scoped to the emulator hosts, not a blanket usesCleartextTraffic: production
  builds keep cleartext blocked because this file lives in src/debug only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The host machine as seen from the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
